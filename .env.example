# Tapo D225 Doorbell Camera Configuration
# Copy this file to .env and fill in your values

# Camera IP address (find in Tapo app under Device Info)
TAPO_HOST=192.168.1.100

# Camera account credentials (set in Tapo App > Advanced Settings > Camera Account)
# This is a LOCAL account on the camera, NOT your TP-Link cloud login.
# If you haven't set one yet: Tapo App > Device > Settings > Advanced > Camera Account
TAPO_USER=admin
TAPO_PASSWORD=your_camera_password

# TP-Link cloud account password (OPTIONAL)
# Only needed for pytapo's proprietary recording downloader.
# Without this, recordings are downloaded via RTSP playback instead.
# Live streaming works fine without this.
TAPO_CLOUD_PASSWORD=

# Optional: child device ID if camera is connected through a hub (e.g. H200)
# TAPO_CHILD_ID=

# Server settings
APP_HOST=0.0.0.0
APP_PORT=8000
